# Copy these names into Vercel Project Settings → Environment Variables.
# Never commit real credential values to this file or the repository.

# Required for server-side persistence and live opportunity reads
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret

# Configure at least one real supplier source
MATCHER_YAHOO_SHOPPING_APP_ID=replace-with-yahoo-app-id
MATCHER_RAKUTEN_APPLICATION_ID=replace-with-rakuten-application-id
MATCHER_RAKUTEN_ACCESS_KEY=replace-with-rakuten-access-key

# Optional: alternative supplier JSON feed
MATCHER_SUPPLIER_FEED_URL=
MATCHER_SUPPLIER_SOURCE_KEY=
